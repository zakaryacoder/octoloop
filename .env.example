# OCTOLOOP environment example — copy to .env (never commit .env)
# Backend
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
# V2: short-lived access token (15 min). Refresh token (7d, rotating) handles session longevity.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# ENV=production will FAIL startup if SECRET_KEY is default/short (<32 chars).
ENV=development
# Set HTTPS=true to enable HSTS header (only behind TLS termination).
HTTPS=false

# Target PostgreSQL in production; default SQLite for portable demo.
# Postgres example: postgresql+psycopg2://octoloop:octoloop@localhost:5432/octoloop
DATABASE_URL=sqlite:///./database/octoloop.db

# CORS: explicit origins (comma-separated). Wildcard ONLY when ALLOW_CORS_WILDCARD=true (dev convenience).
CORS_ORIGINS=http://localhost:3000
# ALLOW_CORS_WILDCARD=true adds "*" to CORS origins (local demo only; NOT for production). Default: false.
ALLOW_CORS_WILDCARD=true

# Cookie+CSRF auth mode documented but NOT default; SPA uses Bearer + refresh.
USE_COOKIE_AUTH=false

# APScheduler (escalation every 5 min). Opt-in. If false, use external cron hitting POST /escalation/run.
ENABLE_SCHEDULER=false

# Notification providers. "none" => QUEUED status + delivery log (never fake SENT).
NOTIFICATION_EMAIL_PROVIDER=none
NOTIFICATION_SMS_PROVIDER=none
# SMTP_HOST=smtp.example.com SMTP_PORT=587 SMTP_USER= SMTP_PASSWORD=
# TWILIO_ACCOUNT_SID= TWILIO_AUTH_TOKEN= TWILIO_FROM_NUMBER=

# Optional LLM for AI operational intelligence. none => deterministic fallback always.
LLM_PROVIDER=none
# LLM_API_KEY= LLM_MODEL=gpt-4o-mini LLM_TIMEOUT_SECONDS=10

# Login security
MAX_LOGIN_FAILS=5
LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=20

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
